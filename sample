# Copy this file to .env and fill in real values. Never commit .env.
# (This file previously contained real, working credentials committed to git —
#  those were rotated. See MEMORY / chat history for details.)

# --- Server ---
PORT=5110
NODE_ENV=development
# The FRONTEND's origin, not this backend's - every link embedded in an
# email (verify-email, reset-password, payment, quote,
# accept-accountant-invite - see auth.service.js/invoice.service.js/etc.)
# is built as `${APP_URL}/that/path`, and a person clicks it in their
# browser, so it must resolve to the Vue app, not this API server. In prod
# this is your deployed frontend's URL (e.g. https://invoecr-frontend.vercel.app
# or a custom domain) - pointing it at the backend's own URL instead makes
# every one of those links 404 with "Not found", because the backend has no
# matching route at that bare path (its real routes all live under
# /api/v1/...).
APP_URL=http://localhost:5173
# Business logo/signature uploads (Settings -> Business profile) are stored
# as base64 data: URIs directly on the entity document - no third-party
# image host needed, nothing to configure here. Capped at 2MB per file in
# app.js.

# --- Database ---
# Only the password is read from env; host/user live in src/config/db.config.js
MONGO_DB_PASSWORD=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- Paystack ---
PAYSTACK_SECRET_KEY=
PAYSTACK_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:5110/callback

# --- Email (invoice delivery, payment receipts, and payment reminders) ---
# Sent via Resend's HTTP API (https://resend.com), not raw SMTP - avoids
# outbound SMTP ports getting blocked by some hosts, and Resend's free tier
# (100 emails/day, 3k/month at time of writing) covers a small business
# comfortably. Emails are skipped with a console warning if RESEND_API_KEY
# is unset - it won't block invoice creation.
# This is also the lower-friction of the two reminder channels: unlike
# WhatsApp/Termii below, it needs no business verification or template
# approval, so payment reminders can start going out by email the moment
# these vars are filled in, even before WhatsApp is set up.
#
# Setup: sign up at resend.com, add + verify a sending domain (Domains tab -
# it walks you through adding a few DNS records), then create an API key
# (API Keys tab). RESEND_FROM must be an address on that verified domain -
# until a domain is verified, Resend restricts delivery to your own account
# email only, so real customer emails won't go out yet.
RESEND_API_KEY=
RESEND_FROM=no-reply@yourdomain.com

# --- PDF generation (invoice templates, see src/utils/templates/) ---
# Invoices/previews render as HTML then convert to PDF via headless Chromium
# (puppeteer-core - deliberately NOT the full `puppeteer` package, which
# bundles its own Chromium download that can fail in locked-down/offline
# build environments). This means your production host needs an actual
# Chromium/Chrome binary available. Point this at it, e.g.:
#   - Docker: install with `apt-get install -y chromium` and set
#     PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
#   - Bare VM: `npx puppeteer browsers install chrome` then point this at
#     the printed path
# If unset, common system paths are checked automatically - see
# resolveExecutablePath() in src/utils/templates/pdf.js.
PUPPETEER_EXECUTABLE_PATH=

# --- WhatsApp payment reminders (via Termii, src/utils/whatsapp.util.js) ---
# Termii is a Business Solution Provider sitting on top of Meta's WhatsApp
# Business Platform - it fronts the integration with a simpler dashboard/API
# (for a per-message markup on top of Meta's own pricing) but does NOT
# remove Meta's underlying requirements: business verification and an
# approved message template are still mandatory before anything sends.
#   1. Sign up at termii.com and complete Termii's business verification.
#   2. In the Termii dashboard, add a WhatsApp "device" (their term for a
#      connected WhatsApp sender) - this walks you through the same Meta
#      Business Manager verification/phone-number steps, just inside
#      Termii's flow. Note the "Device ID" it gives you - that's
#      TERMII_DEVICE_ID below.
#   3. Grab your API key from the Termii dashboard - that's TERMII_API_KEY.
#   4. Build a WhatsApp message template in the Termii dashboard (they
#      submit it to Meta for approval) with these 6 named variables -
#      matches reminder.service.js:
#
#        Hi {{customer_name}}, this is a reminder from {{business_name}}
#        that invoice {{invoice_number}} has a balance of {{amount_due}}
#        and {{due_label}}. Pay securely here: {{payment_link}}
#
#      Category "Utility" (payment reminders qualify - cheapest tier, and
#      free if the customer messaged you in the last 24h). Approval
#      typically takes hours, sometimes up to 48h - nothing sends until
#      it's approved. Note the template's ID - that's
#      TERMII_WHATSAPP_TEMPLATE_ID below.
# Until all of the above is done, reminders just no-op with a console
# warning - invoice creation/payment are never blocked by this being unset.
TERMII_API_KEY=
TERMII_DEVICE_ID=
TERMII_WHATSAPP_TEMPLATE_ID=
TERMII_BASE_URL=https://api.ng.termii.com

# --- Seerbit virtual accounts (Expenses / Accounts Payable feature) ---
# A business can activate a dedicated virtual bank account via Seerbit
# (Settings -> Business profile) - see src/utils/seerbit.utils.js and
# EntityService.provisionVirtualAccount. This is account provisioning ONLY:
# automatically paying vendors out of this account isn't built yet.
# Seerbit's payout ("Pocket") product is a separate integration with a
# human-facing OTP step and its own compliance approval beyond normal
# merchant KYC, so it's deliberately been left out for now - businesses pay
# vendors themselves and mark expenses as paid from the Expenses page.
#   1. Sign up at seerbit.com and complete Seerbit's merchant
#      verification/KYC.
#   2. Your dashboard starts in Test Mode with test keys, which only ever
#      touch test/sandbox data - safe to use here.
#   3. In Settings -> API Keys, grab your Public Key and Private (Secret)
#      Key - those are SEERBIT_PUBLIC_KEY / SEERBIT_SECRET_KEY below.
# Until both are set, activating a virtual account fails with a clear
# "not available yet" error rather than a silent no-op, since (unlike
# reminders) this is a deliberate action a business owner clicks a button
# for.
SEERBIT_PUBLIC_KEY=
SEERBIT_SECRET_KEY=
SEERBIT_BASE_URL=https://seerbitapi.com
